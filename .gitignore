out/

# Runtime state (GitHub watcher scripts, caches, etc.)
.state/
.state
*.dump
*.sqlite

# Uploaded images (runtime user uploads)
uploads/
**/uploads/

# Local registry snapshots / government exports (large, re-downloadable).
# The CSV template is kept so everyone knows the expected columns.
*.csv
*.zip
!samples/*.csv
!data/reference/*.csv
!data/ground_truth.csv
!data/mca/company_master_data_TEMPLATE.csv

# Captured test-label photos: keep the folders, ignore the photos
data/test_labels/real/*
data/test_labels/fake/*
!data/test_labels/real/.gitkeep
!data/test_labels/fake/.gitkeep

# Frontend (Yadnyesh's track)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/.turbo/
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo
