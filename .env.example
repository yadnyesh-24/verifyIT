# VerifyIT — environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Gemini API key (Vision-model fallback for OCR)
GEMINI_API_KEY=

# Optional: override Tesseract install location (Windows default shown)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata