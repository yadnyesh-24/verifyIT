# VerifyIT — environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Gemini API key (Vision-model fallback for OCR) — bring your own, free from
# https://aistudio.google.com/apikey. No spaces, no quotes: a stray leading
# space fails authentication and every field silently falls back to raw OCR.
# Leave it blank to run OCR-only.
GEMINI_API_KEY=

# Override when Google retires the default model (a retired model 404s and the
# Vision pass is skipped).
# GEMINI_MODEL=gemini-3.8-flash

# --- Registry database (optional) -------------------------------------------
# Unset -> the local Homebrew PostgreSQL: postgresql://127.0.0.1:5432/verifyit
# Set it to share one imported MCA snapshot across the whole team
# (see MCA_SETUP.md section "Shared snapshot (Supabase)").
#
# Supabase: use the *pooler* host, never `db.<ref>.supabase.co` (IPv6-only), and
# session mode - port 5432. The transaction pooler (6543) has no prepared
# statements, no TEMP tables and no session state.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Tesseract OCR engine (Windows: UB-Mannheim build)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata