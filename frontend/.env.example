# Backend FastAPI service. Rewritten by next.config.mjs into /api/* so the
# browser only needs the frontend URL. Default matches the team's local
# FastAPI on port 8000.
BACKEND_URL=http://localhost:8000

# Data source mode:
#   live  -> always call the backend (never mock)
#   mock  -> always use the bundled demo fixtures
#   auto  -> probe /api/health once, persist the choice in localStorage;
#            any runtime failure flips to mock and shows a "Demo data" toast
NEXT_PUBLIC_DATA_MODE=auto