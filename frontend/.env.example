# The frontend never calls the backend by absolute URL. Every request goes to a
# relative /api/... path, which next.config.mjs rewrites to BACKEND_URL. That
# keeps the browser on a single origin, so there is no CORS preflight and no API
# host compiled into the client bundle.
#
# Server-side only - it is NOT prefixed with NEXT_PUBLIC_ and never reaches the browser.
BACKEND_URL=http://localhost:8000

# Where the screens get their data.
#
#   auto (default) - probe /api/health/db once; use the live API if it answers,
#                    otherwise fall back to the bundled fixtures and show the
#                    grey "Demo" pill in the header so nobody mistakes a fixture
#                    for a real verdict.
#   live           - always call the API, and fail loudly if it is down.
#   mock           - always use the fixtures, even with a backend running.
NEXT_PUBLIC_DATA_MODE=auto
